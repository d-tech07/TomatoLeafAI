# Copy to .env for local use (python-dotenv not required; export these in your shell or set them in Vercel).
# Folder with the exported .tflite models (default: ./models_litert)
MODELS_DIR=models_litert
# Optional: base URL the models are downloaded from on Vercel (e.g. a GitHub Release). Leave empty to use MODELS_DIR.
MODEL_BASE_URL=
# Below this calibrated confidence the app says it is not sure
CONF_THRESHOLD=0.60
